---
import { cache, env } from "cloudflare:workers";
import { SparklesIcon } from "lucide-react";
import { fromJSON } from "seroval";
import { PageLikeListClient } from "@/app/[locale]/(common-layout)/_components/page/page-like-button/like-list";
import { OrganizationJsonLd, WebSiteJsonLd } from "@/components/seo/json-ld";
import { messages } from "@/i18n/messages";
import PrivacyPage from "@/routes/-privacy-policy-page";
import TermsPage from "@/routes/-terms-page";
import { readerCacheTags } from "../../../src/app/_domain/reader-cache-tags";
import type { loadReaderData } from "../../../src/app/api/reader-data/_service/load-reader-data";
import { AboutIsland } from "../components/about";
import Article from "../components/article.astro";
import { ControlsIsland } from "../components/controls";
import { HomeFeedIsland } from "../components/home";
import Layout from "../components/layout.astro";
import PageCard from "../components/page-card.astro";
import Pagination from "../components/pagination.astro";
import Profile from "../components/profile.astro";
import { SearchIsland } from "../components/search";

const url = new URL("/api/reader-data", Astro.url);
url.searchParams.set("path", Astro.url.pathname);
url.searchParams.set("search", Astro.url.search);
const backendHeaders = {
	cookie: Astro.request.headers.get("cookie") ?? "",
	authorization: Astro.request.headers.get("authorization") ?? "",
};
const response = env.PREVIEW_GATEWAY_ORIGIN
	? await fetch(url.href, { headers: backendHeaders })
	: await env.BACKEND.fetch(url.href, { headers: backendHeaders });
if (response.status === 404) return Astro.rewrite("/404");
if (!response.ok)
	throw new Error(`Reader data request failed: HTTP ${response.status}`);
const { page: result, gaTrackingId } = fromJSON(await response.json()) as {
	page: NonNullable<Awaited<ReturnType<typeof loadReaderData>>>;
	gaTrackingId: string;
};
// 旧Backendとのローリング更新中は全体タグで安全に無効化する。
const tags = [
	"evame-reader",
	...(await readerCacheTags(result.cacheKeys ?? [])),
];
const cacheTagHeader = tags.join(",");
if (
	result.cacheable &&
	!env.PREVIEW_GATEWAY_ORIGIN &&
	typeof cache?.purge === "function" &&
	tags.length <= 1000 &&
	cacheTagHeader.length <= 16384
) {
	Astro.cache.set({ maxAge: 3600, tags });
	Astro.response.headers.set(
		"Cache-Control",
		"public, max-age=0, must-revalidate",
	);
	Astro.response.headers.set(
		"Cloudflare-CDN-Cache-Control",
		"public, max-age=3600",
	);
	Astro.response.headers.set("Cache-Tag", cacheTagHeader);
} else {
	Astro.cache.set(false);
	Astro.response.headers.set("Cache-Control", "private, no-store");
}
const locale = result.locale;
const metadata = result.metadata;
const t = (messages[locale as keyof typeof messages] ?? messages.en).Reader;
const pageIds =
	result.kind === "article"
		? [result.data.pageDetail.id]
		: result.kind === "new" ||
				result.kind === "tag" ||
				result.kind === "profile"
			? result.data.pageForLists.map((page) => page.id)
			: [];
---
<Layout locale={locale} title={metadata.title} description={metadata.description} canonical={metadata.alternates.canonical} gaTrackingId={gaTrackingId} commonLayout={result.kind !== "terms" && result.kind !== "privacy"}>
  <Fragment slot="head">{Object.entries(metadata.alternates.languages).map(([lang, href]) => <link rel="alternate" hreflang={lang} href={href} />)}{("image" in metadata && metadata.image) && <meta property="og:image" content={metadata.image} />}{result.kind === "article" && !result.cacheable && <meta name="robots" content="noindex, nofollow" />}<meta property="og:type" content={result.kind === "article" ? "article" : result.kind === "profile" ? "profile" : "website"} /></Fragment>
  <OrganizationJsonLd /><WebSiteJsonLd locale={locale} />
  {result.kind === "home" && <HomeFeedIsland locale={locale} initialData={result.data} client:load />}
  {result.kind === "article" && <Article data={result.data} locale={locale} page={result.page} isPublic={result.cacheable} />}
  {result.kind === "profile" && <Profile data={result.data} locale={locale} page={result.page} sort={result.sort} />}
  {result.kind === "about" && result.data.pageDetail && <AboutIsland locale={locale} search={Astro.url.search} pageDetail={result.data.pageDetail} stats={result.data.stats} client:idle />}
  {(result.kind === "new" || result.kind === "tag") && <div class="flex flex-col gap-8 mb-12"><section class="flex flex-col gap-4"><h1 class="text-2xl font-semibold mb-4 flex items-center gap-2"><SparklesIcon className="w-4 h-4" />{result.kind === "tag" ? result.tagName : t.newPages}</h1>{result.data.pageForLists.map((page, index) => <PageCard page={page} locale={locale} index={index} />)}<Pagination currentPage={result.page} totalPages={result.data.totalPages} /></section></div>}
  {result.kind === "search" && <SearchIsland initialResult={result} search={Astro.url.search} client:load />}
  {result.kind === "terms" && <TermsPage />}
  {result.kind === "privacy" && <PrivacyPage />}
  {result.kind !== "article" && result.kind !== "terms" && result.kind !== "privacy" && <ControlsIsland locale={locale} search={Astro.url.search} sourceLocale="mixed" pageId={null} likeCount={0} client:idle />}
  {pageIds.length > 0 && <PageLikeListClient pageIds={pageIds} client:idle />}
</Layout>
