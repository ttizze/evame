---
import { PaginationBar } from "@/app/[locale]/(common-layout)/_components/pagination-bar";

interface Props {
	currentPage: number;
	totalPages: number;
}
const { currentPage, totalPages } = Astro.props;
---
{totalPages > 1 && <div class="mt-8 flex justify-center"><PaginationBar currentPage={currentPage} totalPages={totalPages} pathname={Astro.url.pathname} search={Astro.url.search} /></div>}
