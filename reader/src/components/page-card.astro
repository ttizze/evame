---
import { PageLikeButtonClient } from "@/app/[locale]/(common-layout)/_components/page/page-like-button/client";
import { PageList } from "@/app/[locale]/(common-layout)/_components/page/page-list";
import type { PageForList } from "@/app/[locale]/types";
import { UserAvatar } from "@/components/user-avatar";
import { PageOwnerActionsIsland } from "./page-owner-actions";

interface Props {
	page: PageForList;
	locale: string;
	index: number | null;
}
const { page, locale, index } = Astro.props;
---
<PageList PageForList={page} locale={locale} index={index} likeButton={null} ownerActions={null} avatar={null}>
  <UserAvatar slot="avatar" className="w-5 h-5 shrink-0" image={page.userImage} name={page.userHandle} client:visible />
  <PageLikeButtonClient slot="like-button" showCount={false} pageId={page.id} initialLikeCount={page.likeCount} client:visible />
  {index === null && <PageOwnerActionsIsland slot="owner-actions" locale={locale} handle={page.userHandle} pageId={page.id} slug={page.slug} status={page.status} client:load />}
</PageList>
