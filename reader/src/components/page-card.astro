---
import { PageLikeButtonClient } from "@/app/[locale]/(common-layout)/_components/page/page-like-button/client";
import { PageList } from "@/app/[locale]/(common-layout)/_components/page/page-list";
import type { PageForList } from "@/app/[locale]/types";
import PageAvatar from "./page-avatar.astro";

interface Props {
	page: PageForList;
	locale: string;
	index: number | null;
}
const { page, locale, index } = Astro.props;
---
<PageList PageForList={page} locale={locale} index={index} likeButton={null} avatar={null}>
  <PageAvatar slot="avatar" image={page.userImage} name={page.userHandle} />
  <PageLikeButtonClient slot="like-button" showCount={false} pageId={page.id} initialLikeCount={page.likeCount} client:load />
</PageList>
