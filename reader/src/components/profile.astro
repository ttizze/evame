---
import Linkify from "linkify-react";
import { ProfilePageJsonLd } from "@/components/seo/json-ld";
import { messages } from "@/i18n/messages";
import type { loadReaderData } from "../../../src/app/api/reader-data/_service/load-reader-data";
import PageCard from "./page-card.astro";
import Pagination from "./pagination.astro";
import { ProfileFollowIsland } from "./profile-follow";
import { ProfileSortIsland } from "./profile-sort";

type Props = {
	data: Extract<
		NonNullable<Awaited<ReturnType<typeof loadReaderData>>>,
		{ kind: "profile" }
	>["data"];
	locale: string;
	page: number;
	sort: "popular" | "new";
};
const { data, locale, page, sort } = Astro.props;
const { pageOwner } = data;
const t = (messages[locale as keyof typeof messages] ?? messages.en).Reader;
---
<ProfilePageJsonLd description={pageOwner.profile || undefined} image={pageOwner.image || undefined} name={pageOwner.name} url={`https://evame.tech/${locale}/${pageOwner.handle}`} />
<section class="mb-8 py-4">
 {pageOwner.profile && <div><Linkify options={{ className: "underline" }}>{pageOwner.profile}</Linkify></div>}
 {pageOwner.twitterHandle && <div class="mt-4"><a href={`https://x.com/${pageOwner.twitterHandle}`} rel="noreferrer" target="_blank"><img alt="X" class="dark:invert" height="20" width="20" src="/x.svg" /></a></div>}
 <ProfileFollowIsland locale={locale} userId={pageOwner.id} client:load />
</section>
<ProfileSortIsland locale={locale} sort={sort} search={Astro.url.search} pathname={Astro.url.pathname} client:load />
{data.pageForLists.length === 0 && <p class="text-center text-gray-500 mt-10">{t.noPages}</p>}
<div>{data.pageForLists.map((page) => <PageCard page={page} locale={locale} index={null} />)}</div>
<Pagination currentPage={page} totalPages={data.totalPages} />
