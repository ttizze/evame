---
import { EyeIcon, MessageCircle } from "lucide-react";
import { PageTagList } from "@/app/[locale]/(common-layout)/_components/page/page-tag-list";
import { SegmentElement } from "@/app/[locale]/(common-layout)/_components/wrap-segments/segment";
import { PageCommentList } from "@/app/[locale]/(common-layout)/[handle]/[pageSlug]/_components/comment/_components/page-comment-list/server";
import { extractTocItems } from "@/app/[locale]/(common-layout)/[handle]/[pageSlug]/_domain/extract-toc-items";
import { ArticleJsonLd, BreadcrumbJsonLd } from "@/components/seo/json-ld";
import { messages } from "@/i18n/messages";
import { LikeButton } from "../../../shared/like-button";
import type { loadReaderData } from "../../../src/app/api/reader-data/_service/load-reader-data";
import ArticleTools from "./article-tools.astro";
import { CommentsIsland } from "./comments";
import FloatingControls from "./floating-controls.astro";
import PageLikes from "./page-likes.astro";
import { ChildPagesIsland, PageNavigationIsland } from "./page-navigation";
import { StaticBody } from "./static-body";

type Props = {
	data: Extract<
		NonNullable<Awaited<ReturnType<typeof loadReaderData>>>,
		{ kind: "article" }
	>["data"];
	locale: string;
	page: number;
	isPublic: boolean;
};
const { locale, data, page, isPublic } = Astro.props;
const { pageDetail, navigationData } = data;
const t = (messages[locale as keyof typeof messages] ?? messages.en).Reader;
const tocItems = extractTocItems({
	mdast: pageDetail.mdastJson,
	segments: pageDetail.segments,
});
const articleUrl = `https://evame.tech/${pageDetail.sourceLocale}/${pageDetail.userHandle}/${pageDetail.slug}`;
const authorUrl = `https://evame.tech/${pageDetail.sourceLocale}/${pageDetail.userHandle}`;
const titleSegment = pageDetail.segments.find(
	(segment) => segment.number === 0,
);
---
<PageLikes pageIds={[pageDetail.id]}><article class="w-full prose dark:prose-invert prose-a:underline lg:prose-lg mx-auto mb-20">
  {!isPublic && <div class="sticky top-0 z-50 w-full bg-secondary text-foreground rounded-xl"><div class="mx-auto max-w-5xl px-3 py-2 text-sm flex items-center justify-between"><span>{t.preview}</span></div></div>}
  {isPublic && <><ArticleJsonLd authorName={pageDetail.userName} authorUrl={authorUrl} datePublished={new Date(pageDetail.createdAt).toISOString()} dateModified={new Date(pageDetail.updatedAt).toISOString()} headline={pageDetail.title} description={data.description} image={`https://evame.tech/api/og?locale=${pageDetail.sourceLocale}&slug=${pageDetail.slug}`} inLanguage={pageDetail.sourceLocale} url={articleUrl} /><BreadcrumbJsonLd items={[{ name: "Home", url: `https://evame.tech/${locale}` }, { name: pageDetail.userName, url: authorUrl }, { name: pageDetail.title, url: articleUrl }]} /></>}
  {navigationData && <PageNavigationIsland locale={locale} search={Astro.url.search} pageId={pageDetail.id} data={navigationData} client:interaction />}
  {titleSegment && <h1 class="mb-0!"><SegmentElement segment={titleSegment} /></h1>}
  <PageTagList locale={locale} tag={pageDetail.tagPages.map(({ tag }) => tag)} />
  <ArticleTools locale={locale} search={Astro.url.search} handle={pageDetail.userHandle} slug={pageDetail.slug} createdAt={pageDetail.createdAt} tocItems={tocItems} />
  <StaticBody mdast={pageDetail.mdastJson} segments={pageDetail.segments} />
  {data.childPages.length > 0 && <ChildPagesIsland locale={locale} search={Astro.url.search} pages={data.childPages} client:interaction />}
  <div class="flex flex-wrap items-center gap-4"><EyeIcon className="h-5 w-5" strokeWidth={1.5} /><evame-page-views class="text-muted-foreground" data-page-id={pageDetail.id}>{data.pageViewCount}</evame-page-views><LikeButton pageId={pageDetail.id} likeCount={data.pageCounts.likeCount} liked={false} pending={false} disabled={true} onClick={null} /><MessageCircle className="h-5 w-5" strokeWidth={1.5} /><span class="text-muted-foreground" data-comment-count={pageDetail.id}>{data.comments.count}</span></div>
  <FloatingControls locale={locale} search={Astro.url.search} sourceLocale={pageDetail.sourceLocale} pageId={pageDetail.id} />
  <section class="mt-8 space-y-4" id="comments"><h2 class="text-2xl font-bold not-prose">{t.comments}</h2><CommentsIsland search={Astro.url.search} pathname={Astro.url.pathname} locale={locale} pageId={pageDetail.id} initialPage={page} initialData={data.comments} initialList={null} client:visible><PageCommentList slot="initial-list" comments={data.comments.comments} userLocale={locale} /></CommentsIsland></section>
</article></PageLikes>
