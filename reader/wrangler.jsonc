{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "evame-reader",
	"account_id": "c7b7a7ae01fa84965620a5b3f7e79286",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-06",
	"compatibility_flags": ["nodejs_compat", "disable_nodejs_console_module"],
	"workers_dev": false,
	"preview_urls": false,
	"assets": { "binding": "ASSETS", "directory": "dist" },
	"services": [
		{
			"binding": "BACKEND",
			"service": "evame-start",
			"entrypoint": "ReaderBackend"
		},
		{ "binding": "SELF", "service": "evame-reader" }
	],
	"r2_buckets": [
		{ "binding": "READER_HTML", "bucket_name": "evame-reader-html" }
	],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"cache": { "enabled": true },
	"limits": { "cpu_ms": 300000 },
	"triggers": { "crons": ["0 * * * *"] },
	"observability": { "enabled": true }
}
