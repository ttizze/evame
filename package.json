{
	"name": "digital-buddhism",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
		"lint": "bunx @biomejs/biome ci .",
		"test": "vitest",
		"test:run": "vitest run",
		"biome": "bunx @biomejs/biome check --write .",
		"biome:check": "bunx @biomejs/biome ci .",
		"typecheck": "tsc --noEmit",
		"db:migrate": "tsx src/db/migrate.ts"
	},
	"dependencies": {
		"@better-auth/core": "1.6.2",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-label": "2.1.8",
		"@radix-ui/react-progress": "1.1.8",
		"@radix-ui/react-slot": "1.2.4",
		"@tailwindcss/typography": "0.5.19",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-start": "^1.168.49",
		"@tursodatabase/serverless": "^1.4.0",
		"better-auth": "1.6.2",
		"class-variance-authority": "0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "1.8.0",
		"pg": "8.20.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shadcn": "4.2.0",
