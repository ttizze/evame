{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!bun.lockb",
			"!build",
			"!.vscode",
			"!.output",
			"!node_modules",
			"!**/.build",
			"!**/DerivedData",
			"!apps/ios/DerivedData-Lexical",
			"!apps/ios/ComrakProbe/target",
			"!apps/ios/LexicalProbe/Swift/Generated",
			"!**/*.xcodeproj",
			"!apps/ios/Sources/EditorCore/Resources/*.js",
			"!apps/ios/Tests/EditorCoreTests/Fixtures/Upstream",
			"!**/*.css",
			"!playwright-report",
			"!cst",
			"!coverage",
			"!.turbo",
			"!.vercel",
			"!**/.wrangler",
			"!**/.astro",
			"!**/.data",
			"!**/dist",
			"!.cache",
			"!dist",
			"!.codex",
			"!.claude",
			"!.worktree",
			"!.worktrees",
			"!src/routeTree.gen.ts"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"useSortedAttributes": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": { "level": "warn", "fix": "safe" },
				"useUniqueElementIds": "off"
			},
			"performance": {
				"noImgElement": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		},
		"formatter": {
			"enabled": true
		}
	},
	"json": {
		"parser": { "allowComments": true },
		"formatter": {
			"enabled": true,
			"indentWidth": 2,
			"lineWidth": 80
		}
	}
}
