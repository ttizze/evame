{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "evame-gateway",
	"account_id": "c7b7a7ae01fa84965620a5b3f7e79286",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-03",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"services": [
		{ "binding": "READER", "service": "evame-reader" },
		{ "binding": "APP", "service": "evame-start" },
		{
			"binding": "MONITORING",
			"service": "evame-start",
			"entrypoint": "GatewayMonitoring"
		}
	],
	"kv_namespaces": [
		{ "binding": "SETTINGS", "id": "e5faa34f97e44136a060e561e11f3d9d" }
	],
	"observability": { "enabled": true },
	"previews": {
		"kv_namespaces": [
			{ "binding": "SETTINGS", "id": "e5faa34f97e44136a060e561e11f3d9d" }
		]
	}
}
