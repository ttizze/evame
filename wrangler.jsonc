{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "digital-buddhism",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/worker/index.ts",
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"queues": {
		"producers": [
			{
				"binding": "TRANSLATION_QUEUE",
				"queue": "digital-buddhism-translations"
			}
		],
		"consumers": [
			{
				"queue": "digital-buddhism-translations",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "digital-buddhism-translations-dlq"
			},
			{
				"queue": "digital-buddhism-translations-dlq",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	}
}
