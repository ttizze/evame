# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5434/main
DB_BRANCH_MODE=1

# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
EMAIL_FROM=

# Generate ENCRYPTION_KEY with: openssl rand -hex 32
ENCRYPTION_KEY=

# Maintenance uses the SETTINGS KV binding in wrangler.jsonc

# Public build-time URL; server-only configuration must not use VITE_ prefixes
VITE_PUBLIC_DOMAIN=http://localhost:3000
CF_IMAGE_HOST=images.evame.tech
GOOGLE_ANALYTICS_ID=

# Optional translation services
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_PUBLISH_BASE_URL=
GCP_PROJECT_ID=
GCP_REGION=us-central1
# JSON service-account credentials; keep private keys out of source and logs
GCP_SERVICE_ACCOUNT_CREDENTIALS=

# Disable Sentry while developing or testing locally
SENTRY_DSN=
VITE_SENTRY_DSN=

# CLI API endpoint
EVAME_BASE_URL=http://localhost:3000
