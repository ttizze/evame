# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5434/main
DB_BRANCH_MODE=1

# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
EMAIL_FROM=

# Generate ENCRYPTION_KEY with: openssl rand -hex 32
ENCRYPTION_KEY=

# Edge Config connection string with a boolean maintenance item
EDGE_CONFIG=

# Public build-time URL; server-only configuration must not use VITE_ prefixes
VITE_PUBLIC_DOMAIN=http://localhost:3000
CF_IMAGE_HOST=images.evame.tech
GOOGLE_ANALYTICS_ID=

# Optional translation and image-upload services
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_PUBLISH_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# CLI API endpoint
EVAME_BASE_URL=http://localhost:3000
